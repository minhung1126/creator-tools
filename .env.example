# Server
HOST=localhost
PORT=8000
SECRET_KEY=creator-tools-super-secret-key-change-in-production-2026
# Dedicated key recommended. Keep unchanged after credentials have been saved.
CREDENTIAL_ENCRYPTION_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
DEFAULT_PLAYLIST_ID=
DEFAULT_SPREADSHEET_ID=
DEFAULT_DRIVE_FOLDER_ID=

# Instagram API with Instagram Login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must exactly match Meta App > Instagram > Valid OAuth Redirect URIs.
# Leave empty to use https://HOST/api/v1/instagram/auth/callback (or localhost equivalent).
INSTAGRAM_REDIRECT_URI=
# Configurable default, not a claim that this will always be Meta's latest version.
INSTAGRAM_API_VERSION=v25.0

# Cloudflare R2 defaults. These may also be entered in the Instagram / R2 settings page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
