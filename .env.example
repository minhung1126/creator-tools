# Server
BIND_HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

SECRET_KEY=generate-a-unique-secret
# Dedicated key recommended. Keep unchanged after credentials have been saved.
CREDENTIAL_ENCRYPTION_KEY=
ALLOWED_GOOGLE_EMAILS=admin@example.com

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
DEFAULT_SPREADSHEET_ID=
DEFAULT_PLAYLIST_ID=

# Instagram API with Instagram Login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Cloudflare R2 non-secret defaults. Store the secret only through the UI.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
