# Server / network
# Bind address for the server process. Use 0.0.0.0 when it must be reachable
# through Docker or a reverse proxy; this is not the public URL.
BIND_HOST=0.0.0.0
PORT=8000
# Public URL used to build Google and Instagram OAuth callbacks.
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

SECRET_KEY=generate-a-unique-secret
# Dedicated key recommended. Keep unchanged after credentials have been saved.
CREDENTIAL_ENCRYPTION_KEY=
# Google login allowlist. Required in production; comma-separated emails.
ALLOWED_GOOGLE_EMAILS=admin@example.com

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Instagram API with Instagram Login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Instagram traffic shaping (optional; values are percentages/seconds).
INSTAGRAM_USAGE_SOFT_THRESHOLD=80
INSTAGRAM_USAGE_HARD_THRESHOLD=95
INSTAGRAM_USAGE_RECHECK_SECONDS=300
INSTAGRAM_COOLDOWN_BASE_SECONDS=60
INSTAGRAM_COOLDOWN_MAX_SECONDS=3600
INSTAGRAM_COOLDOWN_JITTER_SECONDS=15
INSTAGRAM_PUBLISHING_LIMIT_HOURS=24
INSTAGRAM_METADATA_CACHE_SECONDS=30
INSTAGRAM_PUBLISHING_LIMIT_CACHE_SECONDS=30
INSTAGRAM_CONTAINER_INITIAL_POLL_SECONDS=5
INSTAGRAM_CONTAINER_MAX_POLL_SECONDS=45
INSTAGRAM_CONTAINER_POLL_JITTER_SECONDS=2
INSTAGRAM_CONTAINER_MAX_POLLS=40

# YouTube quota policy defaults. The authenticated YouTube settings page is
# the source of truth and persists changes under data/runtime_config.json.
YOUTUBE_GENERAL_QUOTA_LIMIT=10000
YOUTUBE_QUOTA_SAFETY_BUFFER_UNITS=1000

# Google Sheet, YouTube playlist, Drive folder, and Cloudflare R2 settings are
# configured after login in the web UI and persisted under data/.
