# Server / network
# Use an explicit deployment profile. Production validation is fail-closed.
ENVIRONMENT=development
# Bind address for the server process. Use 0.0.0.0 when it must be reachable
# through Docker or a reverse proxy; this is not the public URL.
BIND_HOST=0.0.0.0
PORT=8000
# Optional host-side port used by docker-compose; keep it private by default.
HOST_PORT=8000
# Optional comma-separated Host header allowlist. The public URL host is used
# automatically when this is empty.
TRUSTED_HOSTS=
# Public URL used to build the Google OAuth callback.
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Set both values to different, random, persistent values in production.
SECRET_KEY=
# Dedicated key. Keep unchanged after credentials have been saved.
CREDENTIAL_ENCRYPTION_KEY=
# Google login allowlist. Required in production; comma-separated emails.
ALLOWED_GOOGLE_EMAILS=admin@example.com

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# YouTube quota policy defaults. The authenticated YouTube settings page is
# the source of truth and persists changes under data/runtime_config.json.
YOUTUBE_GENERAL_QUOTA_LIMIT=10000
YOUTUBE_QUOTA_SAFETY_BUFFER_UNITS=1000

# Google Sheet and YouTube playlist settings are
# configured after login in the web UI and persisted under data/.
