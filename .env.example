# Server Configuration
# HOST: hostname only (e.g. localhost, mysite.com)
# PORT: backend server port
# When HOST is localhost/127.0.0.1 → uses http://, otherwise → https://
HOST=localhost
PORT=8000

# Google OAuth 2.0 Credentials
# Obtain these from Google Cloud Console (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Application Security Secret
# ⚠️ MUST be changed for production deployments!
SECRET_KEY=creator-tools-super-secret-key-change-in-production-2026

# Default Settings (Optional — these can also be set via the Settings UI)
# Values set via UI are persisted in runtime_config.json and take priority.
DEFAULT_PLAYLIST_ID=PLhu1MP3FpZmHar5qPZJkl6zCqXzddF4nC
DEFAULT_SPREADSHEET_ID=1xsxDJ80-TOQs3d3ecHALEbyMlxxEkwXNjHaW7yA8wVs
