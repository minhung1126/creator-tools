# Server / network
# Use an explicit deployment profile. Production validation is fail-closed.
ENVIRONMENT=development
# Bind address for the server process. Use 0.0.0.0 when it must be reachable
# through Docker or a reverse proxy; this is not the public URL.
BIND_HOST=0.0.0.0
PORT=8000
# Optional host-side port used by docker-compose; keep it private by default.
HOST_PORT=8000
# Optional comma-separated Host header allowlist. The public URL host is used
# automatically when this is empty.
TRUSTED_HOSTS=
# Public URL used to build the Google OAuth callback.
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Set both values to different, random, persistent values in production.
SECRET_KEY=
# Dedicated key. Keep unchanged after credentials have been saved.
CREDENTIAL_ENCRYPTION_KEY=
# Google login allowlist. Required in production/HTTPS; replace the empty
# value with real comma-separated Google account email(s).
ALLOWED_GOOGLE_EMAILS=

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# YouTube OAuth slots. Primary may use the same client ID and secret as the
# Google OAuth login above. Both clients must use the same callback URI.
YOUTUBE_OAUTH_PRIMARY_CLIENT_ID=
YOUTUBE_OAUTH_PRIMARY_CLIENT_SECRET=
YOUTUBE_OAUTH_PRIMARY_LABEL=Primary
YOUTUBE_OAUTH_SECONDARY_ENABLED=false
YOUTUBE_OAUTH_SECONDARY_CLIENT_ID=
YOUTUBE_OAUTH_SECONDARY_CLIENT_SECRET=
YOUTUBE_OAUTH_SECONDARY_LABEL=Secondary
YOUTUBE_OAUTH_DEFAULT_SLOT=primary

# First-run per-slot quota defaults. The authenticated YouTube settings page
# is the source of truth and persists changes under data/runtime_config.json.
YOUTUBE_PRIMARY_GENERAL_QUOTA_LIMIT=10000
YOUTUBE_PRIMARY_QUOTA_SAFETY_BUFFER_UNITS=1000
YOUTUBE_SECONDARY_GENERAL_QUOTA_LIMIT=10000
YOUTUBE_SECONDARY_QUOTA_SAFETY_BUFFER_UNITS=1000
YOUTUBE_PRIMARY_VIDEO_UPLOADS_QUOTA_LIMIT=100
YOUTUBE_SECONDARY_VIDEO_UPLOADS_QUOTA_LIMIT=100

# Google Sheet and YouTube playlist settings are
# configured after login in the web UI and persisted under data/.
